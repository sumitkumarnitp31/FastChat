# ==============================================================================
# FastChat Environment Variables Configuration Template
# Copy this file to `.env` in your project root and modify values as needed.
# `.env` should be added to `.gitignore` to protect production credentials.
# ==============================================================================

# Cryptographic Configuration
# Must be identical for api/main.py and server/tcp_server.py to enable valid token handshakes.
# Generate your own secret with: python3 -c "import secrets; print(secrets.token_hex(32))"
FASTCHAT_JWT_SECRET=replace_with_a_long_random_hex_string

# Core Network Infrastructure
FASTCHAT_PORT=8443
FASTCHAT_CERT_FILE=certs/server.crt
FASTCHAT_KEY_FILE=certs/server.key

# Storage & Persistence Layer (PostgreSQL)
# Connection DSN format: postgresql://[user]:[password]@[host]:[port]/[database]
# Adjust to match your local setup or containerized Nginx/Docker service name mappings.
FASTCHAT_DB_DSN=postgresql://fastchat:fastchat@localhost:5432/fastchat

# Database Connection Pool Allocation
# Bound directly to thread-blocking prevention under artificial concurrency bursts.
# Tune these parameters relative to host hardware thresholds and maximum OS file descriptors.
FASTCHAT_DB_POOL_MIN_SIZE=10
FASTCHAT_DB_POOL_MAX_SIZE=50

# Distributed Mesh Routing Layer (Redis Pub/Sub Inter-Process Communication)
# Links concurrent application instances together to prevent state-isolation bottlenecks.
FASTCHAT_REDIS_URL=redis://localhost:6379/0

# Multi-Tenant Isolation Namespace
# Prevents collision metrics if multiple isolated application clusters share a core Redis hub.
FASTCHAT_REDIS_CHANNEL_PREFIX=fastchat:user
